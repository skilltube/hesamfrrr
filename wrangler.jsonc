{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hesamfrrr",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2d97f4d4-04f5-4831-b3fe-c937ceaf9163","database_name": "web-app131" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2fd6f7312f3249cdac1c482dc9692b94" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
